# Banco de dados (Neon Postgres serverless) — ver docs/ADR/0002-neon-postgres.md
DATABASE_URL=

# Auth.js v5 — ver docs/architecture/auth-strategy.md
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Allowlist de e-mails autorizados no painel admin (CSV)
ADMIN_EMAILS=

# Cloudflare R2 (storage/CDN) — ver docs/ADR/0003-cloudflare-r2.md
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_BUCKET_NAME=

# Rate limiting (Upstash) — ver docs/architecture/security.md
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL pública do site (usada em metadata, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL pública do bucket R2 — não é segredo, é lida por componentes client
# (galeria pública). Precisa do prefixo NEXT_PUBLIC_ (ver known-issues.md).
NEXT_PUBLIC_STORAGE_R2_PUBLIC_URL=

# Necessário para `next start` (build de produção local/CI) — a Vercel real
# já confia no host automaticamente por rodar atrás do proxy dela.
AUTH_TRUST_HOST=true
